# Postgres connection string from Neon (https://neon.com)
# Example: postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
# We use @neondatabase/serverless (HTTP-based), so any valid Neon connection
# string works here — no raw TCP access needed, which also makes this
# compatible with Cloudflare's edge runtime.
DATABASE_URL=

# Random 32+ character secret used to sign session JWTs.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Numbers users send money to for manual bKash/Nagad payments.
# Set these in the Cloudflare dashboard (Settings -> Variables and secrets),
# otherwise the upgrade page shows "Not configured yet".
BKASH_NUMBER=
NAGAD_NUMBER=

# Resend (https://resend.com) — used for payment confirmation emails.
# If unset, emails are skipped and logged; payments still work.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's shared onboarding address.
EMAIL_FROM=
# Where "new payment to verify" alerts go.
ADMIN_EMAIL=
# Used to build links inside emails.
SITE_URL=
