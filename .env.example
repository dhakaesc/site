# Postgres connection string from Neon (https://neon.com)
# Example: postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
# We use @neondatabase/serverless (HTTP-based), so any valid Neon connection
# string works here — no raw TCP access needed, which also makes this
# compatible with Cloudflare's edge runtime.
DATABASE_URL=

# Random 32+ character secret used to sign session JWTs.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
